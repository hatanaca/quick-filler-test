# ============================================
# Quick Filler — Environment Variables
# Copy to .env and adjust for your environment
# ============================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Upload limits
UPLOAD_MAX_SIZE_MB=20
UPLOAD_MAX_CONCURRENT_PER_IP=3
PROCESSING_TIMEOUT_MS=60000

# Retention (auto-delete uploads after N minutes)
RETENTION_MINUTES=60

# Security
CORS_ORIGIN=http://localhost:5173
# 300/min por IP: o polling de 2s do frontend consome ~30 req/min por
# transcrição ativa — com UPLOAD_MAX_CONCURRENT_PER_IP=3, 3 simultâneas
# chegam a ~90/min; 100 deixava pouco espaço e um 429 quebrava o polling.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Proxies confiáveis para X-Forwarded-* (CIDRs separados por vírgula).
# Default: loopback. Em deploy atrás de nginx em rede Docker, inclua a
# sub-rede do proxy (ex.: loopback,172.16.0.0/12) para rate limit/fila
# verem o IP real do cliente. Nunca use `true` (spoofing de IP).
TRUST_PROXY=loopback

# OCR
TESSERACT_LANG=por
OCR_WORKER_POOL_SIZE=2
# Escala de renderização de páginas para OCR (A4 a scale=4 ≈ 288 DPI, recomendado).
PDF_RENDER_SCALE=4
# Limiar de confiança do Tesseract (0-100); símbolos abaixo deste valor → `?`.
OCR_CONFIDENCE_THRESHOLD=40
# Pré-processamento de imagem antes do OCR: off | auto (grayscale+Otsu) | color (canal vermelho)
OCR_PREPROCESS=auto
# Modo de segmentação de página do Tesseract (6 = bloco uniforme, bom para tabelas).
OCR_PSM=6
# Whitelist de caracteres do Tesseract (vazio = sem restrição).
OCR_WHITELIST=

# Frontend
VITE_API_URL=http://localhost:3001
