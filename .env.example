# ============================================
# Quick Filler — Environment Variables
# Copy to .env and adjust for your environment
# ============================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Upload limits
UPLOAD_MAX_SIZE_MB=20
UPLOAD_MAX_CONCURRENT_PER_IP=3
PROCESSING_TIMEOUT_MS=60000

# Retention (auto-delete uploads after N minutes)
RETENTION_MINUTES=60

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# OCR
TESSERACT_LANG=por
OCR_WORKER_POOL_SIZE=2

# Frontend
VITE_API_URL=http://localhost:3001
