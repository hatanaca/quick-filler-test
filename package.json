{
  "name": "quick-filler-test",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Quick Filler challenge: transcribe labor documents (time cards and pay stubs) from PDF to structured spreadsheets",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@quickfiller/infrastructure",
    "build": "npm run build --workspace=@quickfiller/domain && npm run build --workspace=@quickfiller/application && npm run build --workspace=@quickfiller/infrastructure && npm run build --workspace=@quickfiller/frontend",
    "prepare": "husky || true",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:domain": "vitest run tests/unit/domain",
    "test:coverage": "vitest run --coverage",
    "samples": "tsx scripts/generate-samples.ts",
    "test-pdfs": "tsx scripts/generate-test-pdfs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
