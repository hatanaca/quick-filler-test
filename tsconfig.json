{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@quickfiller/domain": ["packages/domain/src/index.ts"],
      "@quickfiller/application": ["packages/application/src/index.ts"],
      "@quickfiller/infrastructure": ["packages/infrastructure/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "vitest.config.ts", "eslint.config.js"]
}
